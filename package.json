{
  "name": "tiny-siege",
  "version": "21.0.0",
  "private": true,
  "type": "module",
  "description": "Original 2D lane battler with mobile laser dragon ramping, stun cooldown freeze, electric control, cost-based summon delays, 33 selectable cards, CPU practice and private 1v1 on Cloudflare Workers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/dev.mjs",
    "dev": "wrangler dev --port 8787",
    "login": "wrangler login",
    "whoami": "wrangler whoami",
    "deploy": "wrangler deploy",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:network": "node tests/network.mjs",
    "build:offline": "node scripts/build-offline.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  }
}
