{
  "name": "tiny-siege",
  "version": "46.0.0",
  "private": true,
  "type": "module",
  "description": "TINY SIEGE v46.0.0 full package with offline play, local server and Cloudflare deployment helpers.",
  "engines": {"node": ">=22"},
  "scripts": {
    "start": "node server/dev.mjs",
    "dev": "wrangler dev --port 8787",
    "login": "wrangler login",
    "whoami": "wrangler whoami",
    "deploy": "wrangler deploy",
    "sync:core": "node scripts/sync-game-core.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:offline": "node scripts/build-offline.mjs"
  },
  "devDependencies": {"wrangler": "^4.36.0"}
}
