{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tiny-siege",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BATTLES",
        "class_name": "BattleRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "tiny-siege-v1",
      "new_sqlite_classes": [
        "BattleRoom"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "ENTRY_LIMITER",
      "namespace_id": "90628011",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "90628012",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}